{% raw -%}
name: CI
on:
  pull_request:
  push:
    branches:
      - main
  workflow_dispatch:

# Automatically stop old builds on the same branch/PR
concurrency:
  group: ${{ github.workflow }}-${{ github.ref }}
  cancel-in-progress: true

permissions:
  contents: read

jobs:
  ci:
    # The required check: a fixed name and no matrix, so a branch ruleset can name it.
    name: CI
    timeout-minutes: 30
    runs-on: ubuntu-latest
    steps:
      - name: Check out branch
        uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          # hatch-vcs and the changelog check both read the tags.
          fetch-depth: 0
          persist-credentials: false
      - name: Set up pixi
        uses: prefix-dev/setup-pixi@a09b6247153796b190642a2b53fac4241043cf6f # v0.10.0
        with:
          locked: true
          cache: true
          environments: default
      # A pull request that puts a version heading on top of CHANGELOG.md
      # releases it on merge, so the heading is checked here, before the merge
      # can act on it. See RELEASING.md.
      - name: Check the changelog headings
        run: pixi run python -m tools.changelog check
      - name: Run linting
        run: pixi run lint
        env:
          CLICOLOR_FORCE: 1
      - name: Run pytest
        run: pixi run test --color=yes
      - name: Build the docs
        run: pixi run docs-build
{%- endraw %}

  pytest:
    if: github.event_name != 'pull_request'
    timeout-minutes: 30
    runs-on: {% raw %}${{ matrix.os }}{% endraw %}
    strategy:
      fail-fast: false
      matrix:
{%- set python_versions = ["py312", "py313", "py314"] %}
{%- set minimal_version_index = python_versions.index(minimal_python_version) %}
        environment:
        {%- for python_version in python_versions[minimal_version_index:] %}
          - {{ python_version }}
        {%- endfor %}
        os:
          - ubuntu-latest
          - macos-latest
          - windows-latest{% raw %}
    steps:
      - name: Check out branch
        uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          fetch-depth: 0
          persist-credentials: false
      - name: Set up pixi
        uses: prefix-dev/setup-pixi@a09b6247153796b190642a2b53fac4241043cf6f # v0.10.0
        with:
          locked: true
          cache: true
          environments: ${{ matrix.environment }}
      - name: Run pytest
        run: pixi run -e ${{ matrix.environment }} test-coverage --color=yes
{%- endraw %}
